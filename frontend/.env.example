# Backend API endpoint (change to production URL on Render)
# Development: http://localhost:8000
# Production: https://your-backend-service.onrender.com
VITE_API_BASE_URL=

# Request timeout in milliseconds (default: 30000 = 30s)
VITE_API_TIMEOUT=

# Google OAuth Client ID (get from Google Cloud Console)
# Must match the one configured in backend .env
# Required for sign-in with Google functionality
VITE_GOOGLE_CLIENT_ID=
